# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Auth (NextAuth v5 / Google OAuth) ───────────────────────────────────────
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allowlist of emails permitted to sign in. Leave unset to allow any Google account.
ALLOWED_EMAILS=
# Emails that always get "pro" plan access regardless of subscription status.
GRANTED_PRO_EMAILS=
OWNER_EMAIL=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Market data providers ───────────────────────────────────────────────────
EODHD_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── AI providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ── Ko-fi payments webhook ───────────────────────────────────────────────────
KOFI_USERNAME=
KOFI_VERIFICATION_TOKEN=

# ── Cron jobs (morning email, etc.) ─────────────────────────────────────────
CRON_SECRET=
CRON_EMAIL=

# ── Discord notifications ────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
